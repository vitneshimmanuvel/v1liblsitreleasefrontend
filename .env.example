# ========================================================
# Australia LibList - Frontend Environment Variables
# For Vercel: Set these in Vercel Project Settings -> Environment Variables
# ========================================================

# Backend API Base URL
# - Local Development: http://localhost:5000/api
# - Vercel Production: Replace with your deployed backend URL: https://your-backend-app.vercel.app/api
VITE_API_URL=https://your-backend-app.vercel.app/api

# Groq Cloud AI API Key (Optional client fallback, get from https://console.groq.com/keys)
VITE_GROQ_API_KEY=your_groq_api_key_here
